# Database Connection (Docker Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/epldb?sslmode=disable

# Auth Configuration
BETTER_AUTH_SECRET=development_secret_32_characters_long_key
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Cloudflare R2 / S3 Storage Configuration
# Cloudflare R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_BUCKET_NAME=your_r2_bucket_name
S3_REGION=auto
S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# Redis Connection (Docker Redis)
REDIS_URL=redis://localhost:6379

# Password recovery email: local Mailpit defaults (http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_EMAIL=noreply@epl.local
# Set both SMTP_USER and SMTP_PASS only when your relay requires authentication.

# Optional: comma-separated trusted reverse-proxy IPs/CIDRs for accurate client rate limits.
TRUSTED_PROXY_CIDRS=

# Passkeys: localhost for development; set the stable frontend domain explicitly in production.
PASSKEY_RP_ID=localhost
