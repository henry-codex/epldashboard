    "@epl-fellows-platform/env": "workspace:*",
    "@simplewebauthn/server": "13.2.3",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@epl-fellows-platform/config": "workspace:*",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.23.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
