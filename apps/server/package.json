{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@epl-fellows-platform/api": "workspace:*",
    "@epl-fellows-platform/auth": "workspace:*",
    "@epl-fellows-platform/db": "workspace:*",
    "@epl-fellows-platform/env": "workspace:*",
    "@hono/trpc-server": "^0.4.2",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@trpc/server": "catalog:",
    "ai": "^6.0.3",
    "better-auth": "catalog:",
    "bullmq": "^5.34.8",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uploadthing": "^7.7.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@epl-fellows-platform/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^6.4.17",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "^0.16.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
